:root {
  --bg: #0a0a08;
  --cream: #f0ebe0;
  --gold: #c9a84c;
  --gold-light: #e8c97a;
  --grey: #8a8a7a;
  --mid: #1a1a16;
  --border: rgba(201, 168, 76, 0.2);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--cream);
  font-family: 'Cormorant Garamond', serif;
  cursor: none;
  overflow-x: hidden;
}

/* CUSTOM CURSOR */
.cursor {
  position: fixed;
  width: 10px; height: 10px;
  background: var(--gold);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.1s ease;
  mix-blend-mode: difference;
}
.cursor-ring {
  position: fixed;
  width: 36px; height: 36px;
  border: 1px solid var(--gold);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  transition: all 0.18s ease;
  opacity: 0.6;
}

/* NOISE OVERLAY */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
  opacity: 0.4;
}

/* NAV */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px 60px;
  border-bottom: 1px solid transparent;
  transition: border-color 0.4s, background 0.4s;
}
nav.scrolled {
  border-color: var(--border);
  background: rgba(10,10,8,0.92);
  backdrop-filter: blur(12px);
}
.nav-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px;
  letter-spacing: 0.12em;
  color: var(--gold);
  text-decoration: none;
}
.nav-links {
  display: flex;
  gap: 48px;
  list-style: none;
}
.nav-links a {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--grey);
  text-decoration: none;
  transition: color 0.3s;
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -3px; left: 0;
  width: 0; height: 1px;
  background: var(--gold);
  transition: width 0.3s;
}
.nav-links a:hover, .nav-links a.active { color: var(--cream); }
.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }

/* SECTIONS */
section {
  min-height: 100vh;
  position: relative;
  z-index: 1;
}

/* ── HERO ── */
#home {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 100px 60px 0;
  overflow: hidden;
}
.hero-photo {
  position: absolute;
  top: 0;
  right: 0;
  width: 58%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  opacity: 0;
  animation: fadeUp 1.6s 0.3s forwards;
}
.hero-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.55) 22%, black 48%);
  mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.55) 22%, black 48%);
}
.hero-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, var(--bg) 0%, transparent 30%, transparent 78%, rgba(10,10,8,0.5) 100%);
}
#home .hero-eyebrow,
#home .hero-title,
#home .hero-sub,
#home .hero-line { position: relative; z-index: 2; }
@media (max-width: 768px) {
  .hero-photo { width: 100%; opacity: 0.35 !important; }
  .hero-photo img { object-position: center 25%; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.4) 30%, black 65%); mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.4) 30%, black 65%); }
}
.hero-eyebrow {
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.3em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 24px;
  opacity: 0;
  animation: fadeUp 0.8s 0.2s forwards;
}
.hero-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(96px, 18vw, 220px);
  line-height: 0.88;
  letter-spacing: -0.02em;
  color: var(--cream);
  opacity: 0;
  animation: fadeUp 0.9s 0.4s forwards;
}
.hero-title span { color: var(--gold); display: block; }
.hero-sub {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 22px;
  color: var(--grey);
  margin-top: 32px;
  opacity: 0;
  animation: fadeUp 0.9s 0.7s forwards;
}
.hero-line {
  position: absolute;
  right: 60px;
  bottom: 60px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  opacity: 0;
  animation: fadeUp 0.9s 1s forwards;
}
.hero-line span {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.25em;
  color: var(--grey);
  writing-mode: vertical-rl;
}
.hero-line::after {
  content: '';
  width: 1px;
  height: 80px;
  background: linear-gradient(to bottom, var(--gold), transparent);
}
.hero-bg-text {
  position: absolute;
  bottom: -30px;
  right: -20px;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28vw;
  color: transparent;
  -webkit-text-stroke: 1px rgba(201,168,76,0.06);
  pointer-events: none;
  line-height: 1;
  user-select: none;
}

/* ── OVERVIEW ── */
#overview {
  padding: 120px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.section-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.3em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.section-label::before {
  content: '';
  width: 40px;
  height: 1px;
  background: var(--gold);
}
.section-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(48px, 7vw, 96px);
  letter-spacing: 0.04em;
  line-height: 1;
  margin-bottom: 48px;
}
.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  margin-top: 48px;
}
.overview-card {
  background: var(--mid);
  padding: 48px;
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
  transition: background 0.4s;
}
.overview-card:hover { background: #1f1f18; }
.overview-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px; height: 0;
  background: var(--gold);
  transition: height 0.4s;
}
.overview-card:hover::before { height: 100%; }
.card-num {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 64px;
  color: rgba(201,168,76,0.12);
  line-height: 1;
  margin-bottom: 16px;
}
.card-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 22px;
  letter-spacing: 0.1em;
  color: var(--cream);
  margin-bottom: 12px;
}
.card-text {
  font-size: 16px;
  line-height: 1.7;
  color: var(--grey);
}

/* ── MEMBERS ── */
#members {
  padding: 120px 60px;
  background: var(--mid);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  min-height: auto;
}
.members-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  margin-top: 64px;
}
.member-card {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: var(--bg);
  cursor: none;
}
.member-bg {
  position: absolute;
  inset: 0;
  background: var(--member-photo) center 22%/cover no-repeat;
  filter: grayscale(0.15) brightness(0.85) contrast(1.15);
  opacity: 0.6;
  transition: transform 0.7s cubic-bezier(0.25,0.46,0.45,0.94), filter 0.6s ease, opacity 0.6s ease;
}
.member-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(26,26,20,0.5) 0%, rgba(13,13,10,0.5) 100%),
              linear-gradient(180deg, rgba(10,10,8,0.7) 0%, rgba(10,10,8,0.7) 100%);
}
.member-card:hover .member-bg {
  transform: scale(1.06);
  filter: grayscale(0) brightness(1) contrast(1.1);
  opacity: 1;
}
.member-initial {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 120px;
  color: rgba(201,168,76,0.08);
  transition: all 0.5s;
  line-height: 1;
}
.member-card:hover .member-initial {
  color: rgba(201,168,76,0.14);
  transform: translate(-50%, -62%);
}
.member-info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 32px 28px;
  background: linear-gradient(to top, rgba(10,10,8,0.95) 0%, transparent 100%);
  transform: translateY(20px);
  opacity: 0;
  transition: all 0.4s;
}
.member-card:hover .member-info { transform: translateY(0); opacity: 1; }
.member-name-wrap {
  position: absolute;
  bottom: 28px;
  left: 28px;
  transition: all 0.4s;
}
.member-card:hover .member-name-wrap { bottom: 80px; }
.member-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 32px;
  letter-spacing: 0.08em;
  color: var(--cream);
}
.member-role {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--gold);
  text-transform: uppercase;
  margin-top: 4px;
}
.member-desc {
  font-size: 14px;
  line-height: 1.6;
  color: var(--grey);
  font-style: italic;
}
.member-index {
  position: absolute;
  top: 24px;
  right: 24px;
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  color: rgba(201,168,76,0.4);
  letter-spacing: 0.1em;
}
.member-border {
  position: absolute;
  inset: 0;
  border: 1px solid transparent;
  transition: border-color 0.4s;
  pointer-events: none;
}
.member-card:hover .member-border { border-color: var(--border); }

/* ── HONORABLE MENTIONS ── */
.honorable-mentions {
  margin-top: 80px;
  padding-top: 48px;
  border-top: 1px solid var(--border);
}
.honorable-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.3em;
  color: rgba(201,168,76,0.5);
  text-transform: uppercase;
  margin-bottom: 32px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.honorable-label::before {
  content: '';
  width: 24px;
  height: 1px;
  background: rgba(201,168,76,0.4);
}
.honorable-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
}
.honorable-card {
  background: rgba(10,10,8,0.6);
  border: 1px solid rgba(201,168,76,0.08);
  padding: 24px 20px;
  position: relative;
  overflow: hidden;
  transition: background 0.3s, border-color 0.3s;
}
.honorable-card:hover {
  background: rgba(26,26,22,0.8);
  border-color: rgba(201,168,76,0.2);
}
.honorable-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 2px; height: 0;
  background: rgba(201,168,76,0.4);
  transition: height 0.3s;
}
.honorable-card:hover::before { height: 100%; }
.honorable-name {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px;
  letter-spacing: 0.1em;
  color: rgba(240,235,224,0.7);
  margin-bottom: 6px;
}
.honorable-tag {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.18em;
  color: rgba(201,168,76,0.4);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.honorable-desc {
  font-size: 13px;
  line-height: 1.55;
  color: rgba(138,138,122,0.7);
  font-style: italic;
}

/* ── SPONSORS ── */
#sponsors {
  padding: 100px 60px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.sponsors-intro {
  font-size: 16px;
  color: var(--grey);
  font-style: italic;
  max-width: 500px;
  line-height: 1.7;
  margin-bottom: 64px;
}
.sponsors-tier {
  margin-bottom: 64px;
}
.sponsors-tier-label {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(201,168,76,0.5);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.sponsors-tier-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
}

/* Platinum tier — big */
.sponsors-row-platinum {
  display: flex;
  gap: 2px;
  flex-wrap: wrap;
}
.sponsor-card {
  background: var(--mid);
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: background 0.4s, border-color 0.4s;
  cursor: none;
}
.sponsor-card:hover {
  background: #1f1f18;
  border-color: rgba(201,168,76,0.4);
}
.sponsor-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(201,168,76,0.04) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.4s;
}
.sponsor-card:hover::before { opacity: 1; }

/* Platinum size */
.sponsor-card.platinum {
  padding: 48px 40px;
  flex: 1 1 280px;
  min-height: 180px;
}
.sponsor-card.platinum .sponsor-logo-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 42px;
  letter-spacing: 0.12em;
  color: var(--cream);
  line-height: 1;
  margin-bottom: 10px;
}

/* Gold tier */
.sponsors-row-gold {
  display: flex;
  gap: 2px;
  flex-wrap: wrap;
}
.sponsor-card.gold {
  padding: 32px 28px;
  flex: 1 1 200px;
  min-height: 140px;
}
.sponsor-card.gold .sponsor-logo-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px;
  letter-spacing: 0.1em;
  color: rgba(240,235,224,0.85);
  line-height: 1;
  margin-bottom: 8px;
}

/* Bronze tier */
.sponsors-row-bronze {
  display: flex;
  gap: 2px;
  flex-wrap: wrap;
}
.sponsor-card.bronze {
  padding: 20px 24px;
  flex: 1 1 160px;
  min-height: 100px;
}
.sponsor-card.bronze .sponsor-logo-text {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 20px;
  letter-spacing: 0.1em;
  color: rgba(240,235,224,0.6);
  line-height: 1;
  margin-bottom: 6px;
}

.sponsor-tagline {
  font-family: 'DM Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.sponsor-card.platinum .sponsor-tagline { color: rgba(201,168,76,0.6); }
.sponsor-card.gold    .sponsor-tagline { color: rgba(201,168,76,0.45); }
.sponsor-card.bronze  .sponsor-tagline { color: rgba(201,168,76,0.3); }

.sponsor-tier-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 2px;
}
.sponsor-card.platinum .sponsor-tier-badge {
  color: var(--gold);
  border: 1px solid rgba(201,168,76,0.3);
  background: rgba(201,168,76,0.06);
}
.sponsor-card.gold .sponsor-tier-badge {
  color: rgba(201,168,76,0.6);
  border: 1px solid rgba(201,168,76,0.15);
  background: rgba(201,168,76,0.04);
}
.sponsor-card.bronze .sponsor-tier-badge {
  color: rgba(201,168,76,0.4);
  border: 1px solid rgba(201,168,76,0.1);
  background: rgba(201,168,76,0.02);
}

/* ── HIGHLIGHT OF THE MONTH ── */
#highlight {
  padding: 90px 60px;
  min-height: auto;
  display: flex;
  flex-direction: column;
}
.highlight-box {
  margin-top: 40px;
  display: flex;
  align-items: center;
  gap: 32px;
  max-width: 520px;
}
.highlight-photo {
  flex: 0 0 auto;
  width: 140px;
  height: 140px;
  border: 1px solid var(--border);
  background: var(--mid);
  position: relative;
  overflow: hidden;
}
.highlight-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.highlight-photo.empty img { display: none; }
.highlight-photo.empty::before {
  content: '+';
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 36px;
  color: rgba(201,168,76,0.25);
}
.highlight-photo.empty::after {
  content: 'Add photo';
  position: absolute;
  bottom: 10px;
  left: 0; right: 0;
  text-align: center;
  font-family: 'DM Mono', monospace;
  font-size: 8px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(138,138,122,0.5);
}
.highlight-text { flex: 1; }
.highlight-date {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.25em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 10px;
}
.highlight-caption {
  font-size: 16px;
  line-height: 1.7;
  color: var(--grey);
  font-style: italic;
}
@media (max-width: 768px) {
  #highlight { padding: 70px 24px; }
  .highlight-box { flex-direction: column; align-items: flex-start; gap: 20px; }
  .highlight-photo { width: 110px; height: 110px; }
}

/* ── CONTACT ── */
#contact {
  padding: 120px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.contact-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 120px;
  align-items: start;
  margin-top: 64px;
}
.contact-left p {
  font-size: 20px;
  line-height: 1.8;
  color: var(--grey);
  font-style: italic;
  margin-bottom: 48px;
}
.contact-detail {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}
.contact-detail-label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--gold);
  text-transform: uppercase;
  min-width: 80px;
}
.contact-detail-val {
  font-size: 16px;
  color: var(--cream);
}
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.form-group {
  position: relative;
  margin-bottom: 32px;
}
.form-group label {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  display: block;
  margin-bottom: 8px;
}
.form-group input,
.form-group textarea {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--border);
  padding: 12px 0;
  color: var(--cream);
  font-family: 'Cormorant Garamond', serif;
  font-size: 18px;
  outline: none;
  transition: border-color 0.3s;
  cursor: none;
  resize: none;
}
.form-group input:focus,
.form-group textarea:focus { border-color: var(--gold); }
.form-group textarea { min-height: 100px; }
.form-group input::placeholder,
.form-group textarea::placeholder {
  color: rgba(138,138,122,0.4);
  font-style: italic;
}
.btn-submit {
  align-self: flex-start;
  background: transparent;
  border: 1px solid var(--gold);
  color: var(--gold);
  font-family: 'DM Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  padding: 18px 48px;
  cursor: none;
  position: relative;
  overflow: hidden;
  transition: color 0.3s;
  margin-top: 8px;
}
.btn-submit::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--gold);
  transform: translateX(-100%);
  transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
}
.btn-submit:hover { color: var(--bg); }
.btn-submit:hover::before { transform: translateX(0); }
.btn-submit span { position: relative; z-index: 1; }

/* FOOTER */
footer {
  padding: 40px 60px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
footer p {
  font-family: 'DM Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.15em;
  color: rgba(138,138,122,0.5);
  text-transform: uppercase;
}
.footer-logo {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px;
  letter-spacing: 0.15em;
  color: rgba(201,168,76,0.3);
}

/* ANIMATIONS */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: translateY(0); }
}
.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}
.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

/* SCROLLBAR */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--gold); opacity: 0.4; }

/* ── MEMORY (secret) ── */
#memory {
  padding: 120px 60px;
}

/* ===== MOBILE ===== */
@media (max-width: 768px) {
  body { cursor: auto; }
  .cursor, .cursor-ring { display: none; }

  nav { padding: 16px 20px; }
  .nav-links { gap: 16px; }
  .nav-links a { font-size: 9px; letter-spacing: 0.1em; }

  #home { padding: 0 24px; }
  .hero-title { font-size: clamp(64px, 20vw, 120px); }
  .hero-sub { font-size: 18px; }

  #overview { padding: 80px 36px; }
  #members, #contact, #sponsors { padding: 80px 20px; }
  #memory { padding: 80px 36px; min-height: auto; }

  .overview-grid { grid-template-columns: 1fr; }
  #memory .overview-grid { grid-template-columns: 1fr; }
  .members-grid { grid-template-columns: 1fr 1fr; }
  .member-name { font-size: 24px; }
  .honorable-grid { grid-template-columns: 1fr 1fr; }
  .contact-inner { grid-template-columns: 1fr; gap: 60px; }
  .sponsors-row-platinum,
  .sponsors-row-gold,
  .sponsors-row-bronze { flex-direction: column; }
  .sponsor-card.platinum,
  .sponsor-card.gold,
  .sponsor-card.bronze { flex: 1 1 auto; }

  footer {
    flex-direction: column;
    gap: 12px;
    text-align: center;
    padding: 30px 20px;
  }
}

@media (max-width: 420px) {
  .nav-links { display: none; }
  .honorable-grid { grid-template-columns: 1fr; }
}